{
  "name": "rest-api",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "tsx watch src/infra/server.ts",
    "test": "vitest run --dir src/core/",
    "test:watch": "vitest --dir src/core/",
    "test:coverage": "vitest run --coverage",
    "dev": "docker-compose --profile development up",
    "dev:build": "docker-compose --profile development up --build",
    "deploy": "docker-compose --profile deploy up -d",
    "deploy:build": "docker-compose --profile deploy up -d --build",
    "lint": "eslint . --fix --ext .ts",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@faker-js/faker": "^8.4.1",
