    "@prisma/client": "^5.16.1",
    "@sentry/node": "^8.17.0",
    "@sentry/profiling-node": "^8.17.0",
    "@woovi/node-sdk": "^1.0.1",
    "awilix": "^10.0.2",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "joi": "^17.13.3",
    "joi-to-swagger": "^6.2.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "1.4.5-lts.1",
    "nodemailer": "^6.9.14",
    "otp-generator": "^4.0.1",
    "prettier": "^3.5.3",
    "puppeteer": "^22.14.0",
    "redis": "^4.7.0",
    "swagger-ui-express": "^5.0.1",
    "tsx": "^4.15.7",
    "typescript": "^5.4.5",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/ejs": "^3.1.5",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.14.2",
