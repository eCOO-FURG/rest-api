    "typescript-eslint": "^8.30.1",
    "vite-tsconfig-paths": "^4.3.2",
    "vitest": "^1.6.0"
  },
  "prisma": {
    "schema": "src/infra/database/schema.prisma",
    "seed": "ts-node -r tsconfig-paths/register -P tsconfig.json src/infra/database/seeds/base.ts"
  }
