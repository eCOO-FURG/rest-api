{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "baseUrl": "./",
    "paths": {
      "@/core/*": ["src/core/*"],
      "@/infra/*": ["src/infra/*"],
      "@/test/*": ["src/test/*"]
    },
    "types": ["vitest/globals", "@goodrequest/joi-type-extract"],
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "strictNullChecks": true
  },
  "include": ["src", "src/@types"]
}
