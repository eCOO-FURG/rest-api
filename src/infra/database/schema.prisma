generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ROLE {
  PRODUCER
  USER
  BROKER
  MANAGER
}

model User {
  id          String    @id @default(uuid())
  first_name  String
  last_name   String
  cpf         String    @unique
  email       String    @unique
  phone       String    @unique
  password    String?
  photo       String?
  chat        String?   @unique
  roles       ROLE[]    @default([USER])
  verified_at DateTime?

  created_at DateTime  @default(now())
  updated_at DateTime?

  sessions Session[]
  otps     Otp[]
  bags     Bag[]
  farm     Farm?

  @@map("users")
}

model Session {
  id    String @id @default(uuid())
  ip    String
  agent String

  user_id String
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  created_at DateTime  @default(now())
  updated_at DateTime?

  @@map("sessions")
}

model Otp {
  id String @id @default(uuid())

  value String
  used  Boolean @default(false)

  user_id String
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  created_at DateTime  @default(now())
  updated_at DateTime?

  @@map("otps")
}

enum FARM_STATUS {
  ACTIVE
  INACTIVE
  PENDING
}

model Farm {
  id          String      @id @default(uuid())
  name        String
  tally       String      @unique
  tax         Float
  description String?
  images      String[]
  status      FARM_STATUS @default(PENDING)

  admin_id String @unique
  admin    User   @relation(fields: [admin_id], references: [id], onDelete: Cascade)

  created_at DateTime  @default(now())
  updated_at DateTime?

  catalogs Catalog[]

  @@map("farms")
}

enum PRICING {
  UNIT
  WEIGHT
}

model Product {
  id         String  @id @default(uuid())
  name       String
  image      String
  pricing    PRICING
  archived   Boolean @default(false)
  perishable Boolean @default(false)

  category_id String
  category    Category @relation(fields: [category_id], references: [id], onDelete: Cascade)

  created_at DateTime  @default(now())
  updated_at DateTime?

  offers Offer[]

  @@map("products")
}

model Category {
  id   String @id @default(uuid())
  name String

  created_at DateTime  @default(now())
  updated_at DateTime?

  products Product[]

  @@map("categories")
}

model Cycle {
  id      String @id @default(uuid())
  alias   String @unique
  offer   Int[]
  order   Int[]
  deliver Int[]

  created_at DateTime  @default(now())
  updated_at DateTime?

  bags     Bag[]
  catalogs Catalog[]

  @@map("cycles")
}

model Catalog {
  id  String @id @default(uuid())
  tax Float

  farm_id String
  farm    Farm   @relation(fields: [farm_id], references: [id])

  cycle_id String
  cycle    Cycle  @relation(fields: [cycle_id], references: [id], onDelete: Cascade)

  created_at DateTime  @default(now())
  updated_at DateTime?

  offers Offer[]
  box    Box?

  @@map("catalogs")
}

model Offer {
  id          String    @id @default(uuid())
  amount      Int
  price       Decimal   @db.Decimal(10, 2)
  description String?   @db.VarChar(240)
  expires_at  DateTime?

  catalog_id String
  catalog    Catalog @relation(fields: [catalog_id], references: [id])

  product_id String
  product    Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  created_at DateTime  @default(now())
  updated_at DateTime?

  orders Order[]

  @@map("offers")
}

model Address {
  id String @id @default(uuid())

  street       String
  number       String
  complement   String?
  neighborhood String
  postal_code  String

  created_at DateTime  @default(now())
  updated_at DateTime?

  bags Bag[]

  @@map("addresses")
}

enum BAG_STATUS {
  PENDING
  SEPARATED
  DISPATCHED
  RECEIVED
  DEFERRED
  CANCELLED
}

model Bag {
  id       String  @id @default(uuid())
  code     String
  price    Decimal @db.Decimal(10, 2)
  paid     Boolean @default(false)
  verified Boolean @default(false)

  status BAG_STATUS

  user_id  String
  customer User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  cycle_id String
  cycle    Cycle  @relation(fields: [cycle_id], references: [id], onDelete: Cascade)

  address_id String?
  address    Address? @relation(fields: [address_id], references: [id])

  created_at DateTime  @default(now())
  updated_at DateTime?

  orders   Order[]
  payments Payment[]

  @@map("bags")
}

enum PAYMENT_STATUS {
  PENDING
  DONE
  FAILED
  REFUNDED
}

enum PAYMENT_METHOD {
  CREDIT
  DEBIT
  CASH
  PIX
}

enum PAYMENT_FLAG {
  MASTERCARD
  VISA
  OTHER
}

model Payment {
  id String @id @default(uuid())

  status PAYMENT_STATUS
  method PAYMENT_METHOD
  flag   PAYMENT_FLAG?

  expires_at DateTime?

  bag_id String
  bag    Bag    @relation(fields: [bag_id], references: [id], onDelete: Cascade)

  created_at DateTime  @default(now())
  updated_at DateTime?

  @@map("payments")
}

enum BOX_STATUS {
  PENDING
  VERIFIED
}

model Box {
  id       String     @id @default(uuid())
  verified Int
  status   BOX_STATUS

  catalog_id String  @unique
  catalog    Catalog @relation(fields: [catalog_id], references: [id])

  created_at DateTime  @default(now())
  updated_at DateTime?

  orders Order[]

  @@map("boxes")
}

enum ORDER_STATUS {
  PENDING
  CANCELLED
  RECEIVED
  REJECTED
}

model Order {
  id     String       @id @default(uuid())
  amount Int
  price  Decimal      @db.Decimal(10, 2)
  status ORDER_STATUS

  offer_id String
  offer    Offer  @relation(fields: [offer_id], references: [id], onDelete: Cascade)

  bag_id String
  bag    Bag    @relation(fields: [bag_id], references: [id], onDelete: Cascade)

  box_id String
  box    Box    @relation(fields: [box_id], references: [id], onDelete: Cascade)

  created_at DateTime  @default(now())
  updated_at DateTime?

  @@map("orders")
}
