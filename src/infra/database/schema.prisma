generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ROLE {
  PRODUCER
  USER
  BROKER
  MANAGER
}

model User {
  id          String    @id @default(uuid())
  first_name  String
  last_name   String
  cpf         String    @unique
  email       String    @unique
  phone       String    @unique
  password    String?
  photo       String?
  chat        String?   @unique
  verified_at DateTime?

  created_at DateTime  @default(now())
  updated_at DateTime?

  sessions Session[]
  roles    ROLE[]    @default([USER])

  otps Otp[]
  bags Bag[]
  farm Farm?

  @@map("users")
}

model Session {
  id    String @id @default(uuid())
  ip    String
  agent String

  user_id String
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  created_at DateTime  @default(now())
  updated_at DateTime?

  @@map("sessions")
}

model Otp {
  id String @id @default(uuid())

  value String
  used  Boolean @default(false)

  user_id String
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  created_at DateTime  @default(now())
  updated_at DateTime?

  @@map("otps")
}

enum FARM_STATUS {
  ACTIVE
  INACTIVE
  PENDING
}

model Farm {
  id          String   @id @default(uuid())
  name        String
  tally       String   @unique
  description String?
  photo       String?
  fee         Float
  images      String[]

  status FARM_STATUS @default(PENDING)

  admin_id String @unique
  admin    User   @relation(fields: [admin_id], references: [id], onDelete: Cascade)

  created_at DateTime  @default(now())
  updated_at DateTime?

  offers Offer[]
  boxes  Box[]

  @@map("farms")
}

enum PRICING {
  UNIT
  WEIGHT
}

model Product {
  id         String  @id @default(uuid())
  name       String
  image      String
  pricing    PRICING
  archived   Boolean @default(false)
  perishable Boolean @default(false)

  category_id String
  category    Category @relation(fields: [category_id], references: [id], onDelete: Cascade)

  created_at DateTime  @default(now())
  updated_at DateTime?

  offers Offer[]

  @@map("products")
}

model Category {
  id    String @id @default(uuid())
  name  String
  image String

  created_at DateTime  @default(now())
  updated_at DateTime?

  products Product[]

  @@map("categories")
}

model Cycle {
  id      String @id @default(uuid())
  alias   String @unique
  offer   Int[]
  order   Int[]
  deliver Int[]

  created_at DateTime  @default(now())
  updated_at DateTime?

  bags   Bag[]
  offers Offer[]
  boxes  Box[]

  @@map("cycles")
}

model Market {
  id          String  @id @default(uuid())
  name        String
  description String?
  open        Boolean @default(true)

  created_at DateTime  @default(now())
  updated_at DateTime?

  offers Offer[]
  bags   Bag[]

  @@map("markets")
}

model Offer {
  id String @id @default(uuid())

  amount      Int
  description String? @db.VarChar(240)
  comment     String?

  active Boolean @default(true)

  price Decimal @db.Decimal(10, 2)

  opens_at   DateTime
  closes_at  DateTime?
  expires_at DateTime?

  farm_id String
  farm    Farm   @relation(fields: [farm_id], references: [id])

  product_id String
  product    Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  cycle_id String?
  cycle    Cycle?  @relation(fields: [cycle_id], references: [id])

  market_id String?
  market    Market? @relation(fields: [market_id], references: [id])

  created_at DateTime  @default(now())
  updated_at DateTime?

  orders Order[]

  @@map("offers")
}

model Address {
  id String @id @default(uuid())

  street       String
  number       String
  complement   String?
  neighborhood String
  postal_code  String

  created_at DateTime  @default(now())
  updated_at DateTime?

  bags Bag[]

  @@map("addresses")
}

enum BAG_STATUS {
  CANCELLED
  PENDING
  VERIFIED
  MOUNTED
  DISPATCHED
  RECEIVED
  DEFERRED
}

model Bag {
  id String @id @default(uuid())

  code String

  subtotal Decimal @db.Decimal(10, 2)
  shipping Decimal @db.Decimal(10, 2)
  fee      Decimal @db.Decimal(10, 2)
  comment  String? @db.VarChar(240)

  status BAG_STATUS

  customer_id String?
  customer    User?   @relation(fields: [customer_id], references: [id], onDelete: Cascade)

  cycle_id String?
  cycle    Cycle?  @relation(fields: [cycle_id], references: [id], onDelete: Cascade)

  market_id String?
  market    Market? @relation(fields: [market_id], references: [id])

  address_id String?
  address    Address? @relation(fields: [address_id], references: [id])

  created_at DateTime  @default(now())
  updated_at DateTime?

  payment Payment?
  orders  Order[]

  @@map("bags")
}

enum PAYMENT_STATUS {
  PENDING
  DONE
  FAILED
  REFUNDED
}

enum PAYMENT_METHOD {
  CREDIT
  DEBIT
  CASH
  PIX
}

enum PAYMENT_FLAG {
  MASTERCARD
  VISA
  OTHER
}

model Payment {
  id String @id @default(uuid())

  status PAYMENT_STATUS
  method PAYMENT_METHOD
  flag   PAYMENT_FLAG?

  bag_id String @unique
  bag    Bag    @relation(fields: [bag_id], references: [id], onDelete: Cascade)

  created_at DateTime  @default(now())
  updated_at DateTime?

  @@map("payments")
}

enum BOX_STATUS {
  PENDING
  VERIFIED
}

model Box {
  id String @id @default(uuid())

  status BOX_STATUS

  farm_id String
  farm    Farm   @relation(fields: [farm_id], references: [id], onDelete: Cascade)

  cycle_id String
  cycle    Cycle  @relation(fields: [cycle_id], references: [id], onDelete: Cascade)

  created_at DateTime  @default(now())
  updated_at DateTime?

  orders Order[]

  @@map("boxes")
}

enum ORDER_STATUS {
  PENDING
  CANCELLED
  RECEIVED
  REJECTED
}

model Order {
  id       String  @id @default(uuid())
  amount   Int
  subtotal Decimal @db.Decimal(10, 2)
  fee      Decimal @db.Decimal(10, 2)

  status ORDER_STATUS

  offer_id String
  offer    Offer  @relation(fields: [offer_id], references: [id], onDelete: Cascade)

  bag_id String
  bag    Bag    @relation(fields: [bag_id], references: [id], onDelete: Cascade)

  box_id String?
  box    Box?    @relation(fields: [box_id], references: [id], onDelete: Cascade)

  created_at DateTime  @default(now())
  updated_at DateTime?

  @@map("orders")
}
