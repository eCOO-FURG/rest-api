<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Pedido Confirmado</title>
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <style>
      body {
        font-family: "Poppins", Arial, sans-serif;
        display: flex;
        justify-content: center;
        align-items: center;
        background-color: #ffffff;
        color: #333;
        margin: 0;
        padding: 20px;
        min-height: 100vh;
      }
      .container {
        background-color: #f7f7f7;
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 100%;
        max-width: 400px;
        padding: 40px;
        border-radius: 10px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        text-align: center;
      }
      .header {
        font-size: 22px;
        color: #2f4a4d;
        line-height: 28px;
        font-weight: bold;
        padding-bottom: 10px;
      }
      .subtitle {
        font-size: 14px;
        line-height: 22px;
        color: #2f4a4d;
        margin-bottom: 20px;
      }
      .order-box {
        width: 100%;
        background: white;
        border-radius: 6px;
        padding: 15px;
        font-size: 14px;
        color: #545f71;
        margin-bottom: 15px;
      }
      .order-box strong {
        display: block;
        font-size: 14px;
        text-align: start;
        font-weight: bold;
        padding-bottom: 8px;
      }
      .order-item {
        display: flex;
        justify-content: space-between;
        font-size: 14px;
        padding: 5px 0;
      }
      .total-box {
        width: 100%;
        background: white;
        border-radius: 6px;
        padding: 15px;
        font-size: 14px;
        color: #545f71;
        padding-bottom: 22px;
        text-align: start;
      }
      .pickup-info {
        padding: 22px 0;
        font-size: 14px;
        font-weight: 500;
        line-height: 22px;
        color: #2f4a4d;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="header">Pedido <strong>Confirmado!</strong></div>
      <p class="subtitle">
        Olá, <%= props.first_name %>! A agricultura familiar agradece a sua
        compra!
      </p>

      <% let groupedOrders = {}; let deliveryFee = props.bag.address ? 10.00 :
      0.00; let subtotal = props.bag.total; let feeRate = 0.20; // 20% de
      imposto let feeAmount = subtotal * feeRate; let total = subtotal +
      feeAmount + deliveryFee; let ordersArray = Array.isArray(props.bag.orders)
      ? props.bag.orders : props.bag.orders; ordersArray.forEach((order) => {
      let farmName = order.offer.catalog.farm.name; let productName =
      order.offer.product.name; let pricingType = order.offer.product.pricing;
      if (!groupedOrders[farmName]) { groupedOrders[farmName] = {}; } if
      (!groupedOrders[farmName][productName]) {
      groupedOrders[farmName][productName] = { totalAmount: 0, totalPrice: 0,
      productName: productName, pricingType: pricingType, }; } if (pricingType
      === "WEIGHT") { groupedOrders[farmName][productName].totalAmount +=
      order.amount; groupedOrders[farmName][productName].totalPrice +=
      (order.amount / 1000) * order.offer.price; } else { // Se for UNIT
      groupedOrders[farmName][productName].totalAmount += order.amount;
      groupedOrders[farmName][productName].totalPrice += order.amount *
      order.offer.price; } }); %> <%
      Object.keys(groupedOrders).forEach((farmName) => { %>
      <div class="order-box">
        <strong><%= farmName %></strong>
        <% Object.values(groupedOrders[farmName]).forEach((item) => { %>
        <div class="order-item">
          <span>
            <% if (item.pricingType === "WEIGHT") { %> <%= item.totalAmount >=
            1000 ? (item.totalAmount / 1000).toFixed(2) + 'kg' :
            item.totalAmount + 'g' %> <% } else { %> <%= item.totalAmount + 'un'
            %> <% } %> - <%= item.productName %>
          </span>
          <span>R$<%= Number(item.totalPrice).toFixed(2) %></span>
        </div>
        <% }) %>
      </div>
      <% }) %>

      <div class="total-box">
        <div class="order-item">
          <span>Subtotal:</span>
          <span>R$<%= subtotal.toFixed(2) %></span>
        </div>
        <div class="order-item">
          <span>feea de 20%:</span>
          <span>R$<%= feeAmount.toFixed(2) %></span>
        </div>
        <div class="order-item">
          <span>Entrega:</span>
          <span><%= deliveryFee > 0 ? 'R$10.00' : '*' %></span>
        </div>
        <div class="order-item">
          <strong>Total:</strong>
          <strong>R$<%= total.toFixed(2) %></strong>
        </div>
      </div>

      <% let today = new Date(); let currentDay = today.getDate(); let
      currentMonth = today.getMonth() + 1; let currentYear =
      today.getFullYear(); let firstDay = Math.min(...props.cycle.deliver); let
      lastDay = Math.max(...props.cycle.deliver); if (lastDay < currentDay) {
      currentMonth += 1; if (currentMonth > 12) { currentMonth = 1; currentYear
      += 1; } } let formattedMonth = currentMonth.toString().padStart(2, '0');
      let formattedFirstDay = firstDay.toString().padStart(2, '0'); let
      formattedLastDay = lastDay.toString().padStart(2, '0'); %>

      <div class="pickup-info">
        <% if (props.bag.address) { %> Entrega disponível de
        <strong
          ><%= formattedFirstDay %>/<%= formattedMonth %> a <%= formattedLastDay
          %>/<%= formattedMonth %></strong
        >
        <% } else { %> Retire a sua sacola no Armazém e-COO de
        <strong
          ><%= formattedFirstDay %>/<%= formattedMonth %> a <%= formattedLastDay
          %>/<%= formattedMonth %></strong
        >
        <% } %>
      </div>

