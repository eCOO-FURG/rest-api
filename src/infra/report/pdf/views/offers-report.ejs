<!DOCTYPE html>
<html>
  <head>
    <title>Relatório de Ofertas</title>
    <style>
      body {
        font-family: Arial, sans-serif;
        font-size: 14px;
        padding: 40px;
      }

      h1, h2, h3 {
        margin-bottom: 10px;
        color: #2c3e50;
      }

      .catalog {
        margin-bottom: 40px;
        page-break-inside: avoid;
      }

      .farm-name {
        font-weight: bold;
        margin-bottom: 5px;
        text-transform: uppercase;
        color: #34495e;
      }

      table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 10px;
      }

      th, td {
        border: 1px solid #ccc;
        padding: 8px;
        text-align: left;
      }

      th {
        background-color: #f7f7f7;
      }

      .footer {
        margin-top: 40px;
        font-size: 12px;
        color: #888;
        text-align: center;
      }
    </style>
  </head>

  <body>
    <h1>Relatório de Ofertas</h1>

    <% props.catalogs.forEach((catalog) => { %>
      <div class="catalog">
        <h2>Catálogo: <%= catalog.title %></h2>

        <table>
          <thead>
            <tr>
              <th>Fazenda</th>
              <th>Produto</th>
              <th>Quantidade</th>
              <th>Preço</th>
              <th>Taxa</th>
              <th>Total</th>
              <th>Criada em</th>
            </tr>
          </thead>
          <tbody>
            <% catalog.offers.forEach((offer) => { %>
              <tr>
                <td><%= catalog.farm.name %></td>
                <td><%= offer.product.name %></td>
                <td><%= offer.amount %></td>
                <td>R$ <%= offer.price.toLocaleString("pt-BR", { minimumFractionDigits: 2 }) %></td>
                <td>R$ <%= offer.fee.toLocaleString("pt-BR", { minimumFractionDigits: 2 }) %></td>
                <td>R$ <%= (offer.price + offer.fee).toLocaleString("pt-BR", { minimumFractionDigits: 2 }) %></td>
                <td><%= new Date(offer.created_at).toLocaleDateString("pt-BR") %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% }) %>

    <div class="footer">
      e-COO &copy; <%= new Date().getFullYear() %>
    </div>
  </body>
</html>
