<!DOCTYPE html>
<html>
  <head>
    <title>Bags List</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --black: #1d1d1d;
        --dark-green: #222629;
        --gray: #ced0cf;
        --white: #e5e5e5;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        margin: 5mm;
        font-family: "Poppins", sans-serif;
        font-size: 16px;
        font-weight: 400;
        color: var(--black);
      }

      .header {
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        align-items: center;

        width: 100%;
        height: 1.8cm;
        border: 1.8px solid var(--black);
        border-radius: 3.7mm;

        padding: 40px 40px 40px 40px;
      }

      .header h1 {
        font-size: 1.875rem;
        line-height: 2.25rem;
        font-weight: 600;
        color: var(--dark-green);
        text-align: center;
        text-transform: uppercase;
      }

      .header p {
        font-size: 0.875rem;
        line-height: 1.1rem;
        font-weight: 400;
        color: var(--dark-green);
      }

      .logo {
        width: 110px;
        scale: 1.25;
      }

      .page-break {
        page-break-after: avoid;
      }

      .delivery-bag {
        border: 1px solid #000;
        padding: 10px;
      }

      .bag-header {
        font-weight: bold;
      }

      .bag-content {
        margin-left: 10px;
      }

      .footer {
        position: fixed;
        bottom: 10px;
        width: 100%;
        text-align: center;
      }

      .bairro-title {
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
        text-transform: uppercase;
        font-weight: bold;
        background-color: var(--dark-green);
        color: var(--white);
        width: 100%;
        height: 1.35cm;
        border-radius: 3.7mm;
        margin-block: 0;
        margin-top: 15px;
      }

      .bairro-title h2 {
        font-size: 20pt;
        padding-left: 30px;
      }

      .delivery-bag {
        border: 1px solid var(--black);
        border-radius: 3.7mm;
        margin: 0;
        padding: 0;
        margin-top: 5px;
      }

      .bag-header {
        margin: 0;
        padding: 0;
        border-radius: calc(3.7mm - 1px);
        border-bottom-left-radius: 0;
        border-bottom-right-radius: 0;
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
        background-color: var(--gray);
        color: var(--black);
        padding-left: 30px;
        height: 0.85cm;
        border-bottom: 1px solid var(--black);
        font-size: 12pt;
      }

      .bag-header h3 {
        font-size: 0.875rem;
        line-height: 1.25rem;
      }

      .bag-header p {
        font-size: 8pt;
        font-weight: lighter;
        padding-right: 40px;
      }

      .bag-content {
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        align-items: stretch;
        min-height: 1.5cm;
        width: 100%;
      }

      .bag-content > div {
        margin: 0;
        padding: 0;
        height: inherit;
        border-right: 1px solid var(--black);
      }

      .bag-content > div:last-child {
        border-right: none;
      }

      .bag-info {
        flex-grow: 1;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
        align-items: flex-start;
      }

      .bag-info p {
        font-size: 8pt;
        margin-top: 5px;
      }

      .bag-info h5 {
        font-size: 10pt;
        margin-bottom: 5px;
      }

      .bag-info > * {
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: row;
        justify-content: flex-start;
        align-items: center;
        padding-inline: 17px;
        font-weight: normal;
      }

      .bag-info--pedido {
        width: 15%;
      }

      .bag-info--pedido h5 {
        font-size: 10pt;
        font-weight: bolder;
      }

      .bag-info--cliente {
        width: 19.5%;
      }

      .bag-info--conteudo {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        align-items: flex-start;
        width: 250px;
      }

      .bag-info--conteudo p {
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
        width: 100%;
      }

      .bag-info--pagamento {
        width: 15.5%;
      }

      .bag-info--cobrar {
        width: 20%;
      }

      .bag-info--cobrar h5 {
        font-size: 11pt;
        font-weight: bold;
      }
    </style>
  </head>

  <body>
    <div class="header" style="font-family: 'Poppins'">
      <h1>
        <% if (typeof props.withdraw === 'boolean') { %> <%= props.withdraw ?
        "Relatório de retiradas" : "Relatório de entregas" %> <% } else { %>
        Relatório de vendas <% } %>
      </h1>
      <!-- <p>
      Página <span class="pageNumber">1</span> de
      <span class="totalPages">3</span>
    </p> -->
    </div>

    <% const STATUSES = { PENDING: "PENDENTE", CANCELLED: "CANCELADO", RECEIVED:
    "RECEBIDO", REJECTED: "RECUSADO" }; const statusOrder = { PENDING: 0,
    RECEIVED: 1, REJECTED: 2, CANCELLED: 3 }; %> <% props.bags.forEach((bag)=> {
    %>
    <div class="section">
      <!-- <div class="bairro-title" style="page-break-inside: avoid">
        <h2>Passo d'Areia</h2>
      </div> -->
      <div class="delivery-bag" style="page-break-inside: avoid">
        <div class="bag-header">
          <h3>
            <% if (bag.address) { %> <%= bag.address?.street %>, <%=
            bag.address?.number %>, <%= bag.address?.complement %> - <%=
            bag.address?.postal_code %> <% } else { %> Retirada no Armazém e-COO
            <% } %>
          </h3>
          <!-- <p>CEP: 91350-190</p> -->
        </div>
        <div class="bag-content" style="page-break-inside: avoid">
          <div class="bag-info bag-info--pedido">
            <p>Pedido:</p>
            <h5><%= bag.code %></h5>
          </div>
          <div class="bag-info bag-info--cliente">
            <p>Cliente:</p>
            <h5>
              <%= bag.customer.first_name %> <%= bag.customer.last_name %>
            </h5>
          </div>
          <div class="bag-info bag-info--conteudo">
            <p>Conteúdo:</p>
            <h5>
              <% const orders = bag.orders.filter(order => order.status !== "CANCELLED").sort((a, b) => statusOrder[a.status]
              - statusOrder[b.status]); %> <% orders.forEach((order)=> { %> <%
              if (order.offer.product.pricing==='UNIT' ) { %> <%= order.amount
              %> unidades de <%= order.offer.product.name %> <% } else if
              (order.offer.product.pricing==='WEIGHT' ) { %> <% if (order.amount
              >= 1000) { %> <%= (order.amount/1000).toLocaleString("pt-BR", {
              minimumFractionDigits: order.amount % 1000 === 0 ? 0 : 1 }) %>kg
              de <%= order.offer.product.name %> <% } else { %> <%= order.amount
              %>g de <%= order.offer.product.name %> <% } %> <% } %>
              <br />
              R$<%= order.total.toLocaleString("pt-BR", { minimumFractionDigits:
              2 }) %> - <%= STATUSES[order.status] %>
              <br />
              <br />
              <% }); %>
            </h5>
          </div>
          <div class="bag-info bag-info--pagamento">
            <p>Pagamento:</p>
            <h5>Dinheiro</h5>
          </div>
          <div class="bag-info bag-info--cobrar">
            <p>Cobrar:</p>
            <h5>
              R$ <%= (Number(parseFloat(bag.total))).toLocaleString("pt-BR", { minimumFractionDigits: 2 }) %>
            </h5>
          </div>
        </div>
      </div>
    </div>
    <% }); %>
  </body>
</html>
